{
  "name": "mcp-layer-workspace",
  "private": true,
  "packageManager": "pnpm@8.15.4",
  "type": "module",
  "scripts": {
    "build:types": "pnpm -r --if-present build:types",
    "test": "pnpm build:types && pnpm -r --if-present test && node --test --test-timeout=30000 ./test/*.test.js",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "zod@>=3.0.0 <4.0.0": "4.6.7",
      "glob@>=13.0.0 <14.0.0": "14.0.2",
      "minimatch@>=10.0.0 <11.0.0": "11.0.1",
      "hyperid>uuid": "11.1.1"
    }
  }
}
